{
  "name": "Projeto Final — Pipeline ShopBrasil",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [8080, 4040],
  "portsAttributes": {
    "8080": { "label": "Airflow UI (admin/admin)" },
    "4040": { "label": "Spark UI (durante os jobs)" }
  },
  "postStartCommand": "AIRFLOW_UID=$(id -u) docker compose up -d --build"
}
